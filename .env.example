# ─────────────────────────────────────────────────────────────────────
# power-automate-mcp-server configuration
# Copy to .env and fill in. Only AZURE_CLIENT_ID is required.
# ─────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────
# Client id of YOUR app registration (multi-tenant public client).
# See README "App registration". There is intentionally no default.
AZURE_CLIENT_ID=

# ── Auth (optional) ───────────────────────────────────────────────────
# Tenant: "common" (any org) or a specific tenant GUID (e.g. Civala's) for prod.
AZURE_TENANT_ID=common

# "interactive" (device-code, per-user, default) or "clientCredentials" (app-only).
AZURE_AUTH_MODE=interactive

# Required only when AZURE_AUTH_MODE=clientCredentials (also needs a non-"common" tenant).
AZURE_CLIENT_SECRET=

# Flow API audience. Default is correct; override only if a different scope works for your
# app registration (see README "Token audience" — the #1 thing to verify on first run).
# FLOW_RESOURCE=https://service.flow.microsoft.com/
# FLOW_SCOPES=https://service.flow.microsoft.com//.default

# Where the device-code token cache is stored (mode 0600). Point at a mounted volume in Docker.
TOKEN_CACHE_PATH=~/.cache/power-automate-mcp/token.json

# ── Transport ─────────────────────────────────────────────────────────
# "stdio" (local agent, default) or "http" (server/Docker).
TRANSPORT=stdio
PORT=3333
ENDPOINT=/mcp
# Bearer token protecting HTTP operational endpoints (/health/detail, /info, /dashboard)
# and HTTP MCP calls. Leave blank for local/open dev.
MCP_API_KEY=

# ── Behavior ──────────────────────────────────────────────────────────
# Gate the mutating tools (enable/disable/cancel/resubmit/add/remove owner).
ENABLE_WRITE_OPS=false
# If set, tools without an explicit `environment` use this instead of discovering the default.
DEFAULT_ENVIRONMENT=

# ── Telemetry ─────────────────────────────────────────────────────────
# Comma-separated sinks: console, file. File writes NDJSON to TELEMETRY_FILE.
TELEMETRY=console,file
TELEMETRY_FILE=./logs/events.ndjson
LOG_LEVEL=info

# ── Feedback (report_feedback tool) ───────────────────────────────────
# GitHub repo (owner/name) issues are filed against, and a token to file them.
FEEDBACK_GITHUB_REPO=jordanburke/power-automate-mcp-server
GITHUB_TOKEN=
